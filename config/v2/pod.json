                            "link_type": "tcp",
                            "ip": "192.168.2.119",
                            "port": 2000
                        }
                    },
                    "LASER": {
                        "open": "unable",
                        "description": "吊舱激光测距能力"
                    },
                    "STREAM": {
                        "open": "enable",
                        "description": "吊舱流媒体能力",
                        "init_args": {
                            "mediamtx_enable": true,
                            "mediamtx_bin_path": "/home/cs/DockerRoot/fast_cpp_server/source/soft/mediamtx/ubuntu_x86/mediamtx",
                            "check_ip": "192.168.2.119",
                            "yaml_file_name": "mediamtx.yaml",
                            "mediamtx_json_config": {
                                "rtspAddress": ":8555",
                                "paths": {
                                    "live": {
                                        "source": "rtsp://192.168.2.119",
                                        "sourceOnDemand": true
                                    }
                                }
                            }
                        }
                    },
                    "IMAGE": {
                        "open": "unable",
                        "description": "吊舱图像处理能力"
                    },
                    "CENTER_MEASURE": {
                        "open": "unable",
                        "description": "吊舱中心测量能力"
                    }
                },
                "description": "PINLING吊舱,提供视频流和云台控制"
            }
        }
